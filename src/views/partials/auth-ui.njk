{% macro auth_page_header(branding, app, title, logo_margin = 'mb-2', heading_margin = 'mb-4') %}
<div class="flex justify-center {{ logo_margin }}">
  {{ image(branding.logo, { alt: app.title + " Logo", className: 'dark:hidden h-12 w-auto', loading: 'eager', fetchpriority: 'high' }) }}
  {{ image(branding.logoDark, { alt: app.title + " Logo", className: 'hidden dark:block h-12 w-auto', loading: 'eager', fetchpriority: 'high' }) }}
</div>

<div class="{{ heading_margin }} flex justify-center">
  <h1 class="auth-heading text-center font-bold text-primary text-lg sm:text-xl md:text-2xl lg:text-3xl leading-tight break-words">
    <span class="block max-w-full">
      <span class="block w-full text-[clamp(1rem,2.5vw,2rem)]">{{ title }}</span>
    </span>
  </h1>
</div>
{% endmacro %}

{% macro auth_alert(message, variant = 'error') %}
{% if message %}
  {% set is_success = variant == 'success' %}
  <div role="alert" class="{{ 'bg-green-50 dark:bg-green-900 border-2 border-green-200 dark:border-green-700' if is_success else 'bg-red-50 dark:bg-red-900 border-2 border-red-200 dark:border-red-700' }} p-4 mb-4">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 {{ 'text-green-400 dark:text-green-300' if is_success else 'text-red-400 dark:text-red-300' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          {% if is_success %}
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          {% else %}
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          {% endif %}
        </svg>
      </div>
      <div class="ml-3">
        <p class="text-sm {{ 'text-green-800 dark:text-green-200' if is_success else 'text-red-800 dark:text-red-200' }}">{{ message }}</p>
      </div>
    </div>
  </div>
{% endif %}
{% endmacro %}
