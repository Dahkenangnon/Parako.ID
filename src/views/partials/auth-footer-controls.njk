{% if branding and branding.companyName %}
<div class="mt-4 flex items-center justify-center gap-1 text-[11px] text-muted-foreground">
    <span>&copy;</span>
    <span class="font-medium">{{ branding.companyName }}</span>
</div>
{% endif %}

{% set authAvailableLocales = app.locales.available if app and app.locales and app.locales.available else [] %}
{% if authAvailableLocales.length > 1 %}
<div class="mt-3 flex justify-center">
    <label for="language-selector" class="sr-only">{{ t('common.language', 'Language') }}</label>
    <select
        id="language-selector"
        class="w-auto border-0 bg-transparent px-2 py-1 text-[11px] font-medium text-muted-foreground shadow-none hover:text-foreground focus:ring-0"
    >
        {% for loc in authAvailableLocales %}
        <option value="{{ loc }}" {% if loc == userLocale %}selected{% endif %}>{{ loc | upper }}</option>
        {% endfor %}
    </select>
</div>
{% endif %}
