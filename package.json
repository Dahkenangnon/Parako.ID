{
  "name": "parako.id",
  "version": "0.2.3",
  "description": "Self-hosted identity server with SSO, MFA, passkeys, and OAuth2 — zero per-user fees",
  "author": {
    "name": "Justin Dah-kenangnon",
    "email": "dah.kenangnon@gmail.com",
    "url": "https://github.com/Dahkenangnon"
  },
  "private": false,
  "license": "MIT",
  "homepage": "https://parako.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dahkenangnon/Parako.ID"
  },
  "bugs": {
    "url": "https://github.com/Dahkenangnon/Parako.ID/issues"
  },
  "maintainers": [
    "Justin Dah-kenangnon <dah.kenangnon@gmail.com>"
  ],
  "files": [
    "dist",
    "public",
    "runtime",
    "ecosystem.config.cjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "client": "./dist/scripts/manage/client.js",
    "keys": "./dist/scripts/manage/keys.js",
    "systemd": "./dist/scripts/manage/systemd.js"
  },
  "directories": {
    "lib": "dist/src",
    "bin": "dist/scripts/manage",
    "test": "test"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production node scripts/build.js",
    "dev": "node scripts/dev.js",
    "dev:worker": "node --watch-path=dist/src dist/src/worker.js",
    "dev:all": "node scripts/dev.js --with-worker",
    "start": "cross-env NODE_ENV=production pm2 start runtime/ecosystem.config.cjs && pm2 save",
    "restart": "cross-env NODE_ENV=production pm2 startOrRestart runtime/ecosystem.config.cjs && pm2 save",
    "prod:worker": "cross-env NODE_ENV=production pm2 start runtime/ecosystem.config.cjs --only parako-id-worker && pm2 save",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.assets.json",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "lint:check": "npx eslint . --max-warnings 0",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "db:generate": "prisma generate --config=prisma.config.ts",
    "db:generate:pg": "prisma generate --config=prisma.config.pg.ts",
    "db:push": "prisma db push --config=prisma.config.ts",
    "db:migrate": "prisma migrate dev --config=prisma.config.pg.ts",
    "db:migrate:deploy": "prisma migrate deploy --config=prisma.config.pg.ts",
    "db:studio": "prisma studio --config=prisma.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck && pnpm run test:run",
    "clean": "rimraf dist",
    "client": "node dist/scripts/manage/client.js",
    "keys": "node dist/scripts/manage/keys.js",
    "systemd": "node dist/scripts/manage/systemd.js",
    "postinstall": "prisma generate --config=prisma.config.ts",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "oidc",
    "oauth2",
    "openid-connect",
    "identity-provider",
    "authentication",
    "authorization",
    "mfa",
    "2fa",
    "totp",
    "jwt",
    "jwks",
    "parako-id"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@fast-csv/format": "^5.0.7",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/server": "^13.3.2",
    "alpinejs": "^3.15.12",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.80.2",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "compression": "^1.8.1",
    "connect-mongodb-session": "^5.0.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "i18n": "^0.15.3",
    "inquirer": "^14.0.2",
    "inversify": "^7.11.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "jsonc-parser": "^3.3.1",
    "libphonenumber-js": "^1.13.8",
    "lucide": "^1.24.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "nunjucks": "^3.2.4",
    "oidc-provider": "^9.9.1",
    "on-headers": "^1.1.0",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "twilio": "^6.0.2",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@tailwindcss/cli": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/hpp": "^0.2.7",
    "@types/i18n": "^0.13.12",
    "@types/koa": "^3.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/nunjucks": "^3.2.6",
    "@types/oidc-provider": "^9.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "koa": "^3.2.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
