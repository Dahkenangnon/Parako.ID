{
  "name": "parako.id",
  "title": "Parako.ID: Identity Infrastructure You Own",
  "version": "0.3.5",
  "description": "Open-source, self-hosted identity infrastructure for secure SSO, OIDC/OAuth2, MFA, passkeys, and multi-tenant authentication.",
  "author": {
    "name": "Justin Dah-kenangnon",
    "email": "dah.kenangnon@gmail.com",
    "url": "https://github.com/Dahkenangnon"
  },
  "private": true,
  "license": "MIT",
  "homepage": "https://parako.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dahkenangnon/Parako.ID"
  },
  "bugs": {
    "url": "https://github.com/Dahkenangnon/Parako.ID/issues"
  },
  "maintainers": [
    "Justin Dah-kenangnon <dah.kenangnon@gmail.com>"
  ],
  "directories": {
    "lib": "dist/src",
    "bin": "dist/scripts/manage",
    "test": "test"
  },
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production node scripts/build.js --strict",
    "dev": "node scripts/dev.js",
    "dev:worker": "node --watch-path=dist/src dist/src/worker.js",
    "dev:all": "node scripts/dev.js --with-worker",
    "setup:dev": "node scripts/setup-development.ts",
    "setup:env": "node scripts/setup-development.ts --env-only",
    "start": "cross-env NODE_ENV=production node dist/src/index.js",
    "start:worker": "cross-env NODE_ENV=production node dist/src/worker.js",
    "typecheck": "pnpm run typecheck:server && pnpm run typecheck:browser",
    "typecheck:server": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:browser": "tsc --noEmit -p tsconfig.assets.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit -p tsconfig.test-unit.json",
    "typecheck:test:integration": "tsc --noEmit -p tsconfig.test-integration.json",
    "typecheck:test": "pnpm run typecheck:test:unit && pnpm run typecheck:test:integration",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.test-e2e.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --config=prisma.config.ts",
    "db:generate:pg": "prisma generate --config=prisma.config.pg.ts",
    "db:push": "prisma db push --config=prisma.config.ts",
    "db:migrate": "prisma migrate dev --config=prisma.config.pg.ts",
    "db:migrate:deploy": "prisma migrate deploy --config=prisma.config.pg.ts",
    "db:studio": "prisma studio --config=prisma.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration",
    "test:integration:persistence": "vitest run test/integration/db test/integration/models test/integration/multi-tenancy test/integration/storage",
    "test:integration:oidc": "vitest run test/integration/oidc",
    "test:integration:application": "vitest run test/integration/api test/integration/config test/integration/health test/integration/routes test/integration/scripts test/integration/security test/integration/testing test/integration/utils",
    "test:integration:postgresql": "pnpm run db:generate:pg && vitest run --config=test/integration/config/vitest.postgresql.config.ts",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "test:architecture": "node scripts/testing/check-architecture.ts",
    "test:prerequisites": "node scripts/testing/check-prerequisites.ts",
    "test:prerequisites:full": "node scripts/testing/check-prerequisites.ts --full",
    "test:e2e": "pnpm run build && pnpm run test:e2e:cell",
    "test:e2e:cell": "playwright test --config=playwright.config.ts",
    "test:e2e:run": "pnpm run test:e2e:cell",
    "test:e2e:matrix": "node scripts/testing/run-e2e-matrix.ts",
    "test:e2e:matrix:infrastructure": "pnpm run test:e2e:matrix",
    "verify": "pnpm run test:architecture && pnpm run lint:check && pnpm run format:check && pnpm run typecheck && pnpm run typecheck:scripts && pnpm run typecheck:test && pnpm run typecheck:e2e && pnpm run build && pnpm run test:run",
    "verify:all": "pnpm run test:prerequisites:full && pnpm run verify && pnpm run test:integration:postgresql && pnpm run test:e2e:matrix",
    "clean": "rimraf dist",
    "client": "node dist/scripts/manage/client.js",
    "admin": "node dist/scripts/manage/admin.js",
    "database": "node dist/scripts/manage/database.js",
    "diagnostics": "node dist/scripts/manage/diagnostics.js",
    "keys": "node dist/scripts/manage/keys.js",
    "systemd": "node -- dist/scripts/manage/systemd.js",
    "postinstall": "prisma generate --config=prisma.config.ts && prisma generate --config=prisma.config.pg.ts",
    "prepare": "husky",
    "release": "node scripts/release.mjs",
    "release:licenses": "node scripts/check-production-licenses.mjs",
    "release:tag": "node scripts/tag-release.mjs"
  },
  "keywords": [
    "identity",
    "identity-management",
    "iam",
    "sso",
    "self-hosted",
    "oidc",
    "oauth2",
    "openid-connect",
    "identity-provider",
    "authentication",
    "authorization",
    "mfa",
    "2fa",
    "totp",
    "webauthn",
    "passkeys",
    "multi-tenant",
    "jwt",
    "jwks",
    "parako-id"
  ],
  "dependencies": {
    "@alpinejs/csp": "^3.16.1",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@fast-csv/format": "^5.0.7",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.1.2",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "i18n": "^0.15.3",
    "inquirer": "^14.0.2",
    "inversify": "^8.2.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "jsonc-parser": "^3.3.1",
    "libphonenumber-js": "^1.13.11",
    "lucide": "^1.31.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "nunjucks": "^3.2.4",
    "oidc-provider": "^9.11.3",
    "on-headers": "^1.1.0",
    "openid-client": "^6.8.5",
    "otplib": "^13.4.1",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "twilio": "^6.1.0",
    "ua-parser-js": "^2.0.10",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/hpp": "^0.2.7",
    "@types/i18n": "^0.13.12",
    "@types/koa": "^3.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/nunjucks": "^3.2.6",
    "@types/oidc-provider": "^9.11.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "koa": "^3.2.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
