# The source package is private and production releases are built by
# scripts/release.sh. Keep accidental `npm pack` output free of local planning,
# test artifacts, and mutable operator data as a defense-in-depth boundary.
dont-git/
coverage/
playwright-report/
test-results/

runtime/.env
runtime/.tmp-uploads/
runtime/config-backups/
runtime/data/
runtime/jwks/
runtime/locales/.merged/
runtime/logs/
runtime/uploads/
runtime/views/
runtime/parako*.jsonc

*.log
*.pem
*.key
*.p12
*.pfx
